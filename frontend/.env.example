# Base URL of the C# API. No trailing slash — api.js strips one, but keep it
# clean anyway.
#
# Local development (the API's default dev port):
VITE_API_BASE=http://localhost:5109
#
# Production: set this in the Vercel dashboard, not here, e.g.
#   VITE_API_BASE=https://auctionroom-api.onrender.com
#
# NOTE: Vite inlines VITE_* variables at BUILD time, not at runtime. Changing
# this value in the host dashboard has no effect until you redeploy.
