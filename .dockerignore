# Keep the build context small and the image free of host-only artifacts.
**/bin/
**/obj/
**/node_modules/
**/dist/

# Tests run against a live Neon database; they are not part of the runtime image.
tests/

# Frontend deploys separately as a static site (Vercel/Netlify).
frontend/

.git/
.gitignore
.vs/
.idea/
*.user
*.log
*.md
setup-neon.ps1
